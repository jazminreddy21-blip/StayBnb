@model StayBnb.Models.CheckInProcess

@{
    ViewData["Title"] = "Manage Check-In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="mb-2">Manage Check-In</h2>

                    <p class="text-muted mb-4">
                        Property: <strong>@ViewBag.PropertyTitle</strong>
                    </p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-controller="CheckIn"
                          asp-action="Manage"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="PropertyId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Instructions"
                                   class="form-label">
                                Check-In Instructions
                            </label>

                            <textarea asp-for="Instructions"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Explain how guests can access the property, collect keys, and check in."></textarea>

                            <span asp-validation-for="Instructions"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RequiredDocuments"
                                   class="form-label">
                                Required Guest Documents
                            </label>

                            <textarea asp-for="RequiredDocuments"
                                      class="form-control"
                                      rows="4"
                                      placeholder="List the documents guests must provide."></textarea>

                            <span asp-validation-for="RequiredDocuments"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Save Check-In Instructions
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 mt-2">
                            Return Home
                        </a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}