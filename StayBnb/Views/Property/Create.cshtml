@model StayBnb.Models.Property

@{
    ViewData["Title"] = "Become a Host";
}

<div class="staybnb-auth-page">
    <div class="staybnb-auth-card" style="max-width: 650px;">

        <a asp-controller="Home"
           asp-action="Index"
           class="staybnb-auth-brand">
            StayBnb
        </a>

        <h1>Become a host</h1>

        <p class="staybnb-auth-subtitle">
            Share your space with guests and create memorable getaways.
        </p>

      <form asp-controller="Property"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger staybnb-validation"></div>

            <div class="booking-field">
                <label asp-for="Title">Property name</label>
                <input asp-for="Title"
                       class="form-control staybnb-auth-input"
                       placeholder="e.g. Ocean View Apartment" />
                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description"
                          class="form-control staybnb-auth-input"
                          rows="4"
                          placeholder="Describe your property and its features."></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="City">City</label>
                <input asp-for="City"
                       class="form-control staybnb-auth-input"
                       placeholder="e.g. Durban" />
                <span asp-validation-for="City"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="Address">Property address</label>
                <input asp-for="Address"
                       class="form-control staybnb-auth-input"
                       placeholder="Enter the property address" />
                <span asp-validation-for="Address"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="PropertyType">Property type</label>
                <select asp-for="PropertyType"
                        class="form-control staybnb-auth-input">
                    <option value="">Select a property type</option>
                    <option value="Apartment">Apartment</option>
                    <option value="House">House</option>
                    <option value="Guesthouse">Guesthouse</option>
                    <option value="Villa">Villa</option>
                    <option value="Cabin">Cabin</option>
                    <option value="Unique Stay">Unique Stay</option>
                </select>
                <span asp-validation-for="PropertyType"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="PricePerNight">Price per night (R)</label>
                <input asp-for="PricePerNight"
                       type="number"
                       step="0.01"
                       min="1"
                       class="form-control staybnb-auth-input" />
                <span asp-validation-for="PricePerNight"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="CleaningFee">Cleaning fee (R)</label>
                <input asp-for="CleaningFee"
                       type="number"
                       step="0.01"
                       min="0"
                       value="0"
                       class="form-control staybnb-auth-input" />
                <span asp-validation-for="CleaningFee"
                      class="text-danger"></span>
            </div>

            <div class="booking-field">
                <label asp-for="ServiceFee">Service fee (R)</label>
                <input asp-for="ServiceFee"
                       type="number"
                       step="0.01"
                       min="0"
                       value="0"
                       class="form-control staybnb-auth-input" />
                <span asp-validation-for="ServiceFee"
                      class="text-danger"></span>
            </div>
            <div class="booking-field">
    <label for="propertyImage">Property picture</label>

    <input type="file"
           id="propertyImage"
           name="propertyImage"
           accept=".jpg,.jpeg,.png,.webp"
           class="form-control staybnb-auth-input" />

    <small>Upload a JPG, PNG, or WebP image.</small>
</div>

            <button type="submit" class="staybnb-auth-button">
                Submit property for approval
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}