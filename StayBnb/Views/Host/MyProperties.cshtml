
@model IEnumerable<StayBnb.Models.Property>

@{
    ViewData["Title"] = "My Properties";
}

<div class="host-properties-page">
    <div class="host-properties-header">
        <div>
            <span class="host-properties-eyebrow">HOST DASHBOARD</span>
            <h1>My Properties</h1>
            <p>Manage your listings, bookings and check-in information.</p>
        </div>

        <div class="host-properties-actions">
            <a asp-controller="Host"
               asp-action="Bookings"
               class="host-btn host-btn-outline">
                Manage Bookings
            </a>

            <a asp-controller="Property"
               asp-action="Create"
               class="host-btn host-btn-primary">
                + Add Property
            </a>
        </div>
    </div>

    @if (TempData["HostMessage"] != null)
    {
        <div class="host-notice">
            @TempData["HostMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="host-empty-state">
            <div class="host-empty-icon">⌂</div>
            <h2>Your properties will appear here</h2>
            <p>You haven't listed any properties yet. Add your first property to get started.</p>

            <a asp-controller="Property"
               asp-action="Create"
               class="host-btn host-btn-primary">
                Add Your First Property
            </a>
        </div>
    }
    else
    {
        <div class="host-properties-summary">
            <span>You have <strong>@Model.Count()</strong> listed properties</span>
        </div>

        <div class="host-properties-grid">
            @foreach (var property in Model)
            {
                <article class="host-property-card">
                    <div class="host-property-top">
                        <div class="host-property-icon">⌂</div>

                        @if (property.IsActive)
                        {
                            <span class="host-status host-status-approved">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="host-status host-status-pending">
                                Pending Approval
                            </span>
                        }
                    </div>

                    <div class="host-property-info">
                        <h2>@property.Title</h2>

                        <p class="host-property-location">
                            <span aria-hidden="true">⌖</span>
                            @property.City, South Africa
                        </p>

                        <div class="host-property-price">
                            <strong>R @property.PricePerNight.ToString("N2")</strong>
                            <span>/ night</span>
                        </div>
                    </div>

                    <div class="host-property-divider"></div>

                    <a asp-controller="CheckIn"
                       asp-action="Manage"
                       asp-route-propertyId="@property.Id"
                       class="host-btn host-btn-primary host-btn-full">
                        Manage Check-In
                    </a>
                </article>
            }
        </div>
    }
</div>