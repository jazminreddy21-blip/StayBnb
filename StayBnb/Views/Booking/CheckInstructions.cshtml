@model StayBnb.Models.CheckInProcess

@{
    ViewData["Title"] = "Check-In Instructions";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Back to stays
        </a>
    </div>

    <div class="card shadow-sm p-4">
        <h2>Private Check-In Instructions</h2>

        <p class="text-muted">
            These instructions are for your confirmed booking only.
        </p>

        <hr />

        <h5>Arrival Instructions</h5>
        <p style="white-space: pre-line;">@Model.Instructions</p>

        <hr />

        <h5>Required Documents</h5>
        <p style="white-space: pre-line;">@Model.RequiredDocuments</p>
    </div>
</div>