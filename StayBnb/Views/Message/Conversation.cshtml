@model IEnumerable<StayBnb.Models.Message>

@{
    ViewData["Title"] = "Conversation";

    var currentUserId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var otherUserId = ViewBag.OtherUserId as string;
    var otherUserName = ViewBag.OtherUserName as string
        ?? "StayBnb member";
}

<style>
    .chat-page {
        max-width: 900px;
        margin: 35px auto 55px;
        padding: 0 20px;
        color: #352631;
    }

    .chat-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        color: #b23f71;
        font-weight: 700;
        text-decoration: none;
    }

    .chat-back:hover {
        color: #8f2857;
    }

    .chat-shell {
        overflow: hidden;
        border: 1px solid #f0d7e3;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 12px 35px rgba(120, 54, 84, 0.08);
    }

    .chat-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 23px 26px;
        background: linear-gradient(120deg, #fff0f6, #ffe1ed);
        border-bottom: 1px solid #f0d7e3;
    }

    .chat-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #e9a2c1;
        color: #873354;
        font-size: 21px;
    }

    .chat-header h1 {
        margin: 0 0 5px;
        font-size: 21px;
        font-weight: 800;
    }

    .chat-header p {
        margin: 0;
        color: #896f7d;
        font-size: 13px;
    }

    .chat-status {
        margin-left: auto;
        padding: 7px 11px;
        border-radius: 30px;
        background: #fff;
        color: #a52f64;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .chat-messages {
        display: flex;
        flex-direction: column;
        gap: 15px;
        min-height: 320px;
        max-height: 480px;
        overflow-y: auto;
        padding: 25px;
        background: #fffafd;
    }

    .chat-empty {
        margin: auto;
        padding: 35px 10px;
        color: #907987;
        text-align: center;
    }

    .chat-empty i {
        display: block;
        margin-bottom: 12px;
        color: #d77fa5;
        font-size: 35px;
    }

    .chat-row {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 78%;
    }

    .chat-row.mine {
        align-self: flex-end;
        align-items: flex-end;
    }

    .chat-sender {
        margin: 0 8px 5px;
        color: #8f7884;
        font-size: 11px;
        font-weight: 700;
    }

    .chat-bubble {
        padding: 12px 16px;
        border: 1px solid #f0dce5;
        border-radius: 17px 17px 17px 5px;
        background: #fff;
        color: #46313d;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
        line-height: 1.5;
    }

    .chat-row.mine .chat-bubble {
        border-color: #e9a2c1;
        border-radius: 17px 17px 5px 17px;
        background: #f9d8e7;
        color: #52273c;
    }

    .chat-time {
        margin: 5px 8px 0;
        color: #a28d98;
        font-size: 10px;
    }

    .chat-compose {
        padding: 20px 24px;
        border-top: 1px solid #f0dce5;
        background: #fff;
    }

    .chat-error {
        margin-bottom: 12px;
        padding: 11px 13px;
        border: 1px solid #f2b8c8;
        border-radius: 10px;
        background: #fff0f3;
        color: #a52f48;
        font-size: 13px;
    }

    .chat-form {
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    .chat-input {
        flex: 1;
        min-width: 0;
        min-height: 48px;
        max-height: 130px;
        padding: 13px 16px;
        border: 1px solid #e9cfdb;
        border-radius: 15px;
        outline: none;
        background: #fffafd;
        color: #352631;
        font: inherit;
        resize: vertical;
    }

    .chat-input:focus {
        border-color: #cf6594;
        box-shadow: 0 0 0 3px rgba(207, 101, 148, .12);
    }

    .chat-send {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 48px;
        padding: 0 21px;
        border: none;
        border-radius: 15px;
        background: #c34c7d;
        color: white;
        font-weight: 750;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }

    .chat-send:hover {
        transform: translateY(-1px);
        background: #a93667;
    }

    .chat-note {
        margin: 11px 2px 0;
        color: #9a8490;
        font-size: 11px;
    }

    @@media (max-width: 600px) {
        .chat-page {
            margin-top: 20px;
            padding: 0 12px;
        }

        .chat-header {
            padding: 18px;
        }

        .chat-header h1 {
            font-size: 18px;
        }

        .chat-status {
            display: none;
        }

        .chat-messages {
            min-height: 300px;
            padding: 16px;
        }

        .chat-row {
            max-width: 90%;
        }

        .chat-compose {
            padding: 15px;
        }

        .chat-form {
            gap: 8px;
        }

        .chat-send {
            padding: 0 14px;
        }
    }
</style>

<div class="chat-page">
    <a asp-controller="Message"
       asp-action="Index"
       class="chat-back">
        <i class="fa-solid fa-arrow-left"></i>
        Back to Messages
    </a>

    <div class="chat-shell">
        <div class="chat-header">
            <div class="chat-avatar">
                <i class="fa-regular fa-user"></i>
            </div>

            <div>
                <h1>@otherUserName</h1>
                <p>StayBnb guest and host messaging</p>
            </div>

            <span class="chat-status">
                <i class="fa-solid fa-lock"></i>
                Private chat
            </span>
        </div>

        <div class="chat-messages">
            @if (!Model.Any())
            {
                <div class="chat-empty">
                    <i class="fa-regular fa-comments"></i>
                    <strong>Start your conversation</strong>
                    <p>Send a message to get things started.</p>
                </div>
            }
            else
            {
                @foreach (var message in Model)
                {
                    var isMine = message.SenderId == currentUserId;

                    <div class="chat-row @(isMine ? "mine" : "")">
                        <span class="chat-sender">
                            @(isMine ? "You" : otherUserName)
                        </span>

                        <div class="chat-bubble">@message.Content</div>

                        <span class="chat-time">
                            @message.SentAt.ToLocalTime().ToString("dd MMM, HH:mm")
                            @if (isMine)
                            {
                                <span> · Sent</span>
                            }
                        </span>
                    </div>
                }
            }
        </div>

        <div class="chat-compose">
            @if (TempData["MessageError"] != null)
            {
                <div class="chat-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @TempData["MessageError"]
                </div>
            }

            <form asp-controller="Message"
                  asp-action="Send"
                  method="post"
                  class="chat-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="receiverId"
                       value="@otherUserId" />

                <textarea name="content"
                          class="chat-input"
                          rows="1"
                          maxlength="2000"
                          placeholder="Write your message..."
                          aria-label="Message content"
                          required></textarea>

                <button type="submit" class="chat-send">
                    <i class="fa-regular fa-paper-plane"></i>
                    Send
                </button>
            </form>

            <p class="chat-note">
                Please keep your messages respectful and relevant to your stay.
            </p>
        </div>
    </div>
</div>